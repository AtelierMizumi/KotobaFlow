# =============================================================================
# KotobaFlow — Environment Configuration
# Copy this file to .env and adjust values as needed
# =============================================================================

# --- General ---
COMPOSE_PROJECT_NAME=kotobaflow

# --- Device Mode ---
# Set to "gpu" to enable NVIDIA GPU acceleration, "cpu" for CPU-only
# GPU mode requires: NVIDIA driver + nvidia-container-toolkit installed on host
DEVICE_MODE=cpu

# --- Web Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8001

# --- Inference Worker (Faster-Whisper) ---
WHISPER_MODEL=medium
# Device: "cuda" for GPU, "cpu" for CPU-only
WHISPER_DEVICE=cpu
# Compute type: "float16" for GPU, "int8" for CPU
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=ja
WHISPER_BEAM_SIZE=5
WHISPER_CPU_THREADS=4
WHISPER_NUM_WORKERS=1

# --- NLP Processor ---
SUDACHI_DICT_TYPE=small
JMDICT_DB_PATH=/app/data/jmdict.db

# --- Media Handler ---
MEDIA_CACHE_DIR=/app/media-cache
MAX_VIDEO_DURATION=3600
AUDIO_SAMPLE_RATE=16000

# --- Resource Limits (actual limits in docker-compose.yml) ---
# Host: 16GB RAM, NVIDIA RTX 3050 Laptop (4GB VRAM, ~3GB usable)
#
# CPU Mode:
#   web-frontend:      256MB
#   inference-worker:  2048MB  (Whisper medium INT8)
#   nlp-processor:     256MB
#   media-handler:     256MB
#
# GPU Mode:
#   inference-worker uses GPU VRAM for model, CPU RAM drops to ~512MB
