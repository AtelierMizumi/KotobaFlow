# =============================================================================
# KotobaFlow — Environment Configuration
# Copy this file to .env and adjust values as needed
# =============================================================================

# --- General ---
COMPOSE_PROJECT_NAME=kotobaflow

# --- Web Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8001

# --- Inference Worker (Faster-Whisper) ---
WHISPER_MODEL=medium
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=ja
WHISPER_BEAM_SIZE=5
WHISPER_CPU_THREADS=2
WHISPER_NUM_WORKERS=1

# --- NLP Processor ---
SUDACHI_DICT_TYPE=small
JMDICT_DB_PATH=/app/data/jmdict.db

# --- Media Handler ---
MEDIA_CACHE_DIR=/app/media-cache
MAX_VIDEO_DURATION=3600
AUDIO_SAMPLE_RATE=16000

# --- Resource Limits (informational, actual limits in docker-compose.yml) ---
# Total target: < 2GB RAM
# web-frontend:      150MB
# inference-worker: 1500MB
# nlp-processor:     200MB
# media-handler:     100MB
