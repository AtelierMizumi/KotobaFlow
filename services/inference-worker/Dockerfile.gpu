# ==============================================================================
# Inference Worker — GPU variant (NVIDIA CUDA)
# For use with docker-compose.gpu.yml override
# ==============================================================================
FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04

# Install Python and system dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        python3-venv \
        libgomp1 \
        curl \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s /usr/bin/python3 /usr/bin/python

# Create non-root user
RUN groupadd --system --gid 1001 kotobaflow && \
    useradd --system --uid 1001 --gid kotobaflow worker

WORKDIR /app
ENV HF_HOME=/app/models/huggingface

# Install Python dependencies (with CUDA support)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application
COPY app/ ./app/

# Create directories
RUN mkdir -p /app/models /app/media-cache && \
    chown -R worker:kotobaflow /app

USER worker

EXPOSE 8001

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8001"]
